ENVIRONMENT=development
JWT_SECRET=change-this-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

MONGODB_URI=mongodb://mongodb:27017
DATABASE_NAME=sarthi
REDIS_HOST=redis
REDIS_PORT=6379

GOOGLE_MODEL=gemini-3.1-pro
GOOGLE_FAST_MODEL=gemini-2.5-flash
GOOGLE_REASONING_MODEL=gemini-3.1-pro

# Google Cloud Vertex AI configuration (Replaces GOOGLE_API_KEY)
GCP_PROJECT_ID=project-e3e4dcb5-593d-4e61-9a8
GCP_LOCATION=us-central1
USE_VERTEX_AI=true
PARTNER_TRACK=MongoDB
PARTNER_MCP_SERVER=mongodb-mcp-server@latest
MONGODB_MCP_ENABLED=true
MONGODB_MCP_READ_ONLY=true
MONGODB_MCP_STARTUP_TIMEOUT_SECONDS=15

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

GITHUB_TOKEN=
GITHUB_DEFAULT_ORG=
