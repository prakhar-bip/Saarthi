# Sarthi hackathon environment
PROJECT_NAME=Sarthi API
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Auth
JWT_SECRET=change-this-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Datastores
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=sarthi
REDIS_HOST=localhost
REDIS_PORT=6379

# Hackathon partner track
PARTNER_TRACK=MongoDB
PARTNER_MCP_SERVER=mongodb-mcp-server@latest
MONGODB_MCP_ENABLED=true
MONGODB_MCP_READ_ONLY=true
MONGODB_MCP_STARTUP_TIMEOUT_SECONDS=15

# Gemini / Google Cloud Agent Builder runtime
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-3-pro-preview
GOOGLE_FAST_MODEL=gemini-3-flash-preview
GOOGLE_REASONING_MODEL=gemini-3-pro-preview

# Google Cloud Vertex AI (use INSTEAD of GOOGLE_API_KEY for production)
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# Optional fallback providers
OPENROUTER_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b

# Optional GitHub export
GITHUB_TOKEN=
GITHUB_DEFAULT_ORG=
